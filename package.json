{
  "name": "react-email-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "canary:enter": "changeset pre enter canary",
    "canary:exit": "changeset pre exit",
    "lint": "biome check",
    "lint:fix": "biome check --write .",
    "release:build": "turbo run build --filter=./packages/*",
    "release:dry-run": "node --import tsx/esm ./scripts/release.mts --dry-run",
    "release:github": "node --import tsx/esm ./scripts/release.mts",
    "release:pack": "node --import tsx/esm ./scripts/release.mts --pack",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "version": "changeset version && pnpm install --no-frozen-lockfile && pnpm lint:fix"
  },
  "devDependencies": {
    "@actions/core": "3.0.0",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.0",
    "@actions/http-client": "4.0.0",
    "@biomejs/biome": "2.4.12",
    "@changesets/cli": "2.31.0",
    "@changesets/pre": "2.0.2",
    "@manypkg/get-packages": "3.1.0",
    "@octokit/core": "7.0.6",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "21.0.4",
    "mdast-util-to-string": "4.0.0",
    "nypm": "catalog:",
    "pkg-pr-new": "0.0.91",
    "playwright": "1.59.1",
    "remark": "15.0.1",
    "rollup": "4.60.1",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "2.9.14",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.18.0"
}
